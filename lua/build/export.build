$out_root/
{
  include liblua/
  include lua/
  include luac/
}

# Check import target for `lib{lua}` and variants to allow for backwards
# compatibility when using `lua%lib{lua}`. Re-export `lib{lua}` from this
# package when needed.
#
# See: https://github.com/build2/build2/issues/331
#
if ($import.target == lib{lua}  || \
    $import.target == liba{lua} || \
    $import.target == libs{lua})
  export $directory($($out_root/liblua/ liblua))/$import.target
elif ($import.target == exe{lua})
  export $out_root/lua/$import.target
elif ($import.target == exe{luac})
  export $out_root/luac/$import.target
else
  fail Unknown Import Target: $import.target
